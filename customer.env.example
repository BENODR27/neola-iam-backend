# Customer-server .env.container. Example IPs must be replaced with actual hosts.
NODE_ENV=production
PORT=7001
DB_HOST=192.0.2.20
DB_PORT=5432
DB_NAME=authguard
DB_USER=
DB_PASSWORD=
DB_SSL=false
JWT_SECRET=
JWT_ISSUER=platform-iam
JWT_AUDIENCE=platform-applications
JWT_EXPIRES_IN=8h
ALLOW_DEV_AUTH_BYPASS=false
PLATFORM_MASTERS_MODE=shared
CONTROL_PLANE_MODE=subscription
# Your provider's HTTPS IP:port; its TLS certificate must be valid for that IP.
CONTROL_API_URL=https://192.0.2.10:5443
CONTROL_PORTAL_URL=https://192.0.2.10:5443
CONTROL_INSTANCE_ID=
CONTROL_INSTANCE_KEY=
CORS_ORIGIN=https://192.0.2.20:5443
