NODE_ENV=development
PORT=8082
DB_HOST=localhost
DB_PORT=5432
DB_NAME=authguard
DB_USER=postgres
DB_PASSWORD=authguard_dev_password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=your-256-bit-secret-your-256-bit-secret
JWT_EXPIRES_IN=8h
JWT_ISSUER=platform-iam
JWT_AUDIENCE=platform-applications
ALLOW_DEV_AUTH_BYPASS=false
CORS_ORIGIN=*
APP_VERSION=2.0.0
# Optional per-installation Subscription Console integration.
CONTROL_PLANE_MODE=legacy
PLATFORM_MASTERS_MODE=legacy
CONTROL_API_URL=
CONTROL_INSTANCE_ID=
CONTROL_INSTANCE_KEY=
CONTROL_PORTAL_URL=
SUPERADMIN_EMPLOYEE_CODE=superadmin_06f42e8e
SUPERADMIN_NAME=Super Administrator
SUPERADMIN_PASSWORD=change-this-local-superadmin-password
# Customer release images require subscription mode, HTTPS and this pinned public key file.
# CONTROL_LICENSE_PUBLIC_KEY_FILE=/run/secrets/provider-license-public.pem
